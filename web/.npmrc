# Privy's dependency graph does not resolve under npm's strict peer rules, through two conflicts
# that are both spurious for this project:
#
#   ox@0.8 vs ox@0.14   — routed entirely through `permissionless`, an *optional* peer for account
#                         abstraction. It is not installed, and we do not use it.
#   viem@2.56.0 exact   — @privy-io/ethereum pins one patch version; we are on 2.56.3.
#
# Without this file `npm install` needs --legacy-peer-deps and `npm ci` does not take the flag at
# all, so CI resolves differently from a developer's machine and the lockfile drifts out of sync.
# That is not hypothetical — it is how the Pages deploy broke.
legacy-peer-deps=true
