# Copy to web/.env.local. Every value here is public by design — this app is a static export
# (`output: export`), so there is no server to keep a secret on and anything the browser reads is
# in the bundle. Nothing that must stay private belongs in this file or in any NEXT_PUBLIC_ name.

# --- chain -------------------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN=testnet
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_ESCROW_ADDRESS=0xEa057c5a6F431eFF29F573E4db4bc49cD52Ee679
NEXT_PUBLIC_EVENT_ID=latest
NEXT_PUBLIC_DEPLOY_BLOCK=63497445

# --- identity ----------------------------------------------------------------------------------
# App ID, not the App Secret. It is meant to ship in the bundle; the Privy dashboard's domain
# allowlist is what actually stops anyone else using it.
NEXT_PUBLIC_PRIVY_APP_ID=

# --- reading the attestation graph ---------------------------------------------------------------
# Tried first. One indexed query instead of a few hundred eth_getLogs requests.
NEXT_PUBLIC_ENVIO_URL=

# A second endpoint for the same reads. Monad testnet only (chain 10143):
#   https://monad-testnet.g.alchemy.com/v2/YOUR_KEY
#
# The key in this URL ends up in the client bundle. That is not a mistake to be fixed with a
# server-side variable — there is no server. Restrict the key in Alchemy's dashboard to the
# deployment's domain, exactly as the Privy App ID is restricted, and treat it as public.
# Leave blank to skip Alchemy entirely; the fallback chain still works without it.
NEXT_PUBLIC_ALCHEMY_RPC_URL=
# Blocks per eth_getLogs against Alchemy. Ten is what the free tier actually allows, measured with
# a live key on 27 Sep 2026: 11 blocks and above come back "Under the Free tier plan, you can make
# eth_getLogs requests with up to a 10 block range". A paid plan raises it — and because
# lib/rpcProviders.ts orders endpoints by block cap, raising this number is also what moves Alchemy
# ahead of Monad's own endpoint (which serves 100). Do not raise it without re-measuring: a window
# above an endpoint's cap is rejected outright, not served slowly.
NEXT_PUBLIC_ALCHEMY_LOGS_CHUNK=10

# The endpoint that serves logs when Envio and Alchemy are unavailable. Blank uses the network's
# own public RPC.
NEXT_PUBLIC_LOGS_RPC_URL=
NEXT_PUBLIC_LOGS_CHUNK=

# --- build -------------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_PATH=
