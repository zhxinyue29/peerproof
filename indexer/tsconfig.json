{
  /* Options copied from the Envio-maintained v3.10.0 TypeScript indexer
     (enviodev/uniswap-v4-indexer, which pins the same envio 3.10.0), not assembled by hand.
     The comment groupings are theirs too, so a future diff against the template is readable.

     The one that matters for this project is not in here at all: `"type": "module"` in
     package.json. Envio's loader imports handlers with `await import()`, but Node decides a .ts
     file's module system from the nearest package.json, and without that field it takes the
     CommonJS path first, detects ESM syntax, and falls into require(esm) — which is refused the
     moment the handler imports `envio` back. tsconfig does not influence that decision; it only
     makes `tsc` check the file the same way the runtime loads it. */
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    /* For running Envio: */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,

    /* Code doesn't run in the DOM: */
    "lib": ["es2022"],
    "types": ["node"]
  }
}
