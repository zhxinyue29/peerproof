# Local chain config. Written by scripts/dev-chain.sh and holds anvil's private keys — they are
# public defaults, but a repo is not the place to teach anyone that pattern.
web/.env.local
web/.env.local.bak
indexer/.env

# Build output
web/.next/
web/out/
web/node_modules/
indexer/node_modules/
indexer/generated/
indexer/.envio/
indexer/envio-env.d.ts
cre/settle-workflow/node_modules/
contracts/out/
contracts/cache/

# Foundry keeps a "sensitive values" file per broadcast run in cache/. broadcast/ itself is kept:
# it is the provenance record for the deployed address, which the submission cites.
!contracts/broadcast/

node_modules/
.DS_Store
*.tsbuildinfo
next-env.d.ts

# Editor/agent local state
.claude/

# CRE. .env holds CRE_ETH_PRIVATE_KEY, which the simulator requires even for read-only workflows.
cre/.env
cre/**/node_modules/
cre/**/bun.lock
cre/**/.cre/

# 出片：音视频成品体积大，不进仓库。脚本和 cue sheet 进。
出片/**/*.wav
出片/**/*.mp4
出片/**/*.png
